# Shared image for the two Dockerized tool servers (architecture.md §7: each tool server is
# containerized independently so a broken search integration doesn't require redeploying
# the whole pipeline). docker-compose.yml selects which one to run per service via `command:`.
# Same hardening as the main Dockerfile: multi-stage, pinned base, non-root.
FROM python:3.12-slim@sha256:05cda9777409a9c3ffddd94a4c476b79f0769a0b4857f0c7ed9226b6800b0d6f AS build

WORKDIR /app
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
COPY requirements.lock .
RUN pip install --no-cache-dir --require-hashes -r requirements.lock


FROM python:3.12-slim@sha256:05cda9777409a9c3ffddd94a4c476b79f0769a0b4857f0c7ed9226b6800b0d6f

RUN useradd --system --uid 10001 --create-home app
WORKDIR /app
COPY --from=build /opt/venv /opt/venv
COPY --chown=app:app research_langgraph/ ./research_langgraph/

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH=/app \
    PYTHONUNBUFFERED=1

USER app

# Overridden per-service in docker-compose.yml.
CMD ["uvicorn", "research_langgraph.tools.mcp_search_server:app", "--host", "0.0.0.0", "--port", "8001"]
