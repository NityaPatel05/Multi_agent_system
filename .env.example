# Model providers (routing/model_tiers.py) — Groq primary, Gemini fallback per tier.
# Each key variable accepts ONE key or several comma-separated keys (key1,key2,key3).
# When a key is rate-limited/exhausted (429) or rejected (401/403), the next key is tried
# automatically and the bad key is skipped for a cooldown. Other errors do not rotate keys.
# Note: Groq limits are per organisation and Gemini's per project, so extra keys only add
# capacity if they are in separate orgs/projects - check provider terms; as a backup for a
# revoked key they are always fine.
GROQ_API_KEY=
GOOGLE_API_KEY=
# GEMINI_API_KEY also works as an alias for GOOGLE_API_KEY
KEY_RATE_LIMIT_COOLDOWN_S=60
KEY_DEAD_COOLDOWN_S=3600
PROVIDER_TIMEOUT_S=60

# Search adapter (tools/mcp_search_adapter.py) — Exa primary, Tavily fallback.
EXA_API_KEY=
TAVILY_API_KEY=

# All of the above are optional: with none configured, the graph runs end-to-end on
# deterministic offline mocks (see the "self-healing fallback chain" comments in
# routing/model_router.py and tools/mcp_*_adapter.py).

# Checkpointer (memory/checkpointer.py) — Postgres in production; omit for an in-memory
# checkpointer during local dev/smoke tests (does not survive a process restart).
# Under docker-compose this is set automatically to point at the postgres service —
# only fill this in for a non-Docker Postgres instance.
DATABASE_URL=
# Password for the docker-compose postgres service (used to build DATABASE_URL above).
POSTGRES_PASSWORD=

# Episodic memory (memory/episodic_store.py) — Qdrant; omit for a local on-disk JSON store.
QDRANT_URL=
EMBEDDING_PROVIDER=   # empty = offline hash embeddings; 'gemini' = gemini-embedding-001
QDRANT_API_KEY=
EPISODIC_STORE_PATH=.episodic_store.json

# Observability (observability/langsmith_setup.py)
LANGSMITH_API_KEY=

# Offline placeholder extraction: unset = on only when no EXA/TAVILY key is set; 1/0 forces it.
# (In live mode a failed fetch drops the source instead of faking a document.)
OFFLINE_MODE=

# Prompt size caps for scraped documents
DOC_PROMPT_MAX_CHARS=4000
DOCS_PROMPT_MAX_TOTAL_CHARS=100000
# Requests above this many (estimated) tokens skip Groq (free-tier per-minute cap) and go to Gemini
GROQ_MAX_REQUEST_TOKENS=7000

# Eval gate regression tolerance (LLM judge is noisy)
EVAL_TOLERANCE=0.05

# Dockerized MCP tool servers (tools/mcp_search_server.py, mcp_extract_server.py;
# architecture.md §7) — tools/mcp_orchestrator.py dispatches over HTTP when these are
# set, and self-heals back to in-process adapter calls if the server is unreachable.
# Under docker-compose these are set automatically to point at the mcp-search/
# mcp-extract services — leave blank for local (non-Docker) runs, which call the
# adapters in-process exactly as before.
MCP_SEARCH_URL=
MCP_EXTRACT_URL=
MCP_HTTP_TIMEOUT=20

# Parallel fan-out concurrency caps (routing/model_router.py) — keep under your free-tier
# requests/min limit.
GROQ_MAX_CONCURRENCY=4
GEMINI_MAX_CONCURRENCY=4

# ---- Security (docker-compose REQUIRES the first four; generate each with
#      `python -c "import secrets; print(secrets.token_urlsafe(32))"`) ----
# Clients send this as `X-API-Key: <key>` or `Authorization: Bearer <key>`. Comma-separate
# to allow several. If unset when running outside Docker, the API is OPEN (warns at startup).
API_KEY=
# Shared secret between the API and the search/extract tool services.
TOOL_SERVICE_TOKEN=
QDRANT_API_KEY=
# POSTGRES_PASSWORD above must also be set to a strong value (no default in compose).
# Rate limit for run-starting routes, per client per minute; concurrent background runs cap.
RATE_LIMIT_PER_MIN=10
MAX_CONCURRENT_RUNS=4
# Optional: browser frontend origin(s) allowed to call the API, and Host header allow-list.
CORS_ORIGINS=
ALLOWED_HOSTS=
# Extractor SSRF guard: only public IPs are fetched. Set 1 ONLY for local testing against
# localhost servers.
EXTRACT_ALLOW_PRIVATE=
EXTRACT_MAX_BYTES=10485760
EXTRACT_TOTAL_TIMEOUT_S=30

# docker-compose: API is published on 127.0.0.1 only by default. Postgres, Qdrant and the
# tool services have NO published ports (internal network only).
API_BIND=127.0.0.1
API_HOST_PORT=8000
EXTRACT_USER_AGENT=
